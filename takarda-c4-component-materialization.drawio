        <mxCell id="e1" value="marks sitting ready" style="rounded=0;html=1;fontSize=11;exitX=1.00;exitY=0.50;exitDx=0;exitDy=0;entryX=0.00;entryY=0.50;entryDx=0;entryDy=0;jettySize=auto;orthogonalLoop=1;jumpStyle=arc;" edge="1" parent="1" source="evtstore" target="lock"><mxGeometry relative="1" x="0.000" y="0" as="geometry"><Array as="points"><mxPoint x="370" y="335" /><mxPoint x="370" y="115" /></Array></mxGeometry></mxCell>
        <mxCell id="e2" value="starts full batch build" style="rounded=0;html=1;fontSize=11;exitX=0.50;exitY=1.00;exitDx=0;exitDy=0;entryX=0.50;entryY=0.00;entryDx=0;entryDy=0;jettySize=auto;orthogonalLoop=1;jumpStyle=arc;" edge="1" parent="1" source="lock" target="worker"><mxGeometry relative="1" x="0.000" y="0" as="geometry"></mxGeometry></mxCell>
